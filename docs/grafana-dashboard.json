{
  "title": "Inference Control Plane",
  "uid": "inference-control-plane",
  "description": "Read-only inference endpoint observability exported by inference_control_plane.render_prometheus.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "tags": ["inference", "vllm", "sglang"],
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "KV cache usage ratio",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "inference_control_plane_kv_cache_usage_ratio", "legendFormat": "{{endpoint}}"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue waiting",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "inference_control_plane_requests_waiting", "legendFormat": "{{endpoint}}"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "inference_control_plane_error_rate", "legendFormat": "{{endpoint}}"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TTFT p95",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "inference_control_plane_ttft_p95_seconds", "legendFormat": "{{endpoint}}"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Endpoint status",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "inference_control_plane_snapshot_status", "legendFormat": "{{endpoint}} {{status}}"}]
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the host's exporter output",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
